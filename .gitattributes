# Large source files tracked with Git LFS.
# Derived, web-ready products in data/reference/ stay as normal git objects
# so the browser can fetch them directly from Pages.
data/source/*.xlsx  filter=lfs diff=lfs merge=lfs -text
data/source/*.zip   filter=lfs diff=lfs merge=lfs -text
data/source/*.tif   filter=lfs diff=lfs merge=lfs -text
